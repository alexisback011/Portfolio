<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/popover">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALEX"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:fontFamily="@font/unbounded_900"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="."
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:fontFamily="@font/unbounded_900" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADMIN CONSOLE"
            android:textColor="@color/dim"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="8dp"
                android:text="ADMIN"
                android:textColor="#80ADADAD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <LinearLayout
                android:id="@+id/navOverview"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentOverview"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconOverview"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_layout_dashboard"
                    android:contentDescription="Overview" />

                <TextView
                    android:id="@+id/navLabelOverview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Overview"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navUsers"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentUsers"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconUsers"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_users"
                    android:contentDescription="Users" />

                <TextView
                    android:id="@+id/navLabelUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Users"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMessages"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentMessages"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconMessages"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mail"
                    android:contentDescription="Messages" />

                <TextView
                    android:id="@+id/navLabelMessages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Messages"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navReviews"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentReviews"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconReviews"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="Reviews" />

                <TextView
                    android:id="@+id/navLabelReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Reviews"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLogins"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentLogins"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconLogins"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Logins" />

                <TextView
                    android:id="@+id/navLabelLogins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="Logins"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navOtps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="@drawable/nav_item_bg">

                <View
                    android:id="@+id/navAccentOtps"
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/accent_bar"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconOtps"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_key_round"
                    android:contentDescription="OTP Codes" />

                <TextView
                    android:id="@+id/navLabelOtps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="OTP Codes"
                    android:textColor="@color/dim"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/drawerLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_log_out"
            android:contentDescription="Sign out"
            android:tint="@color/danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="Sign out"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/line" />
</LinearLayout>
