<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/panel_expand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="ID"
            android:textColor="#66ADADAD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/leIdValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#B3FAFAFA"
            android:textSize="11sp"
            android:typeface="monospace"
            android:maxLines="1"
            android:ellipsize="middle" />

        <ImageButton
            android:id="@+id/leIdCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_copy"
            android:background="@drawable/btn_ghost"
            android:contentDescription="Copy user ID"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="HASH"
            android:textColor="#66ADADAD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/leHashValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#B3FAFAFA"
            android:textSize="11sp"
            android:typeface="monospace"
            android:maxLines="1"
            android:ellipsize="middle" />

        <ImageButton
            android:id="@+id/leHashCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_copy"
            android:background="@drawable/btn_ghost"
            android:contentDescription="Copy password hash"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="JOINED"
            android:textColor="#66ADADAD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/leJoined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="LOGINS"
            android:textColor="#66ADADAD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/leLogins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/leHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#80ADADAD"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.2" />

    <LinearLayout
        android:id="@+id/loginHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
