<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/chip_user"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/loginStatusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="ADMIN"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/titleBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="26dp">

            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALEX"
                android:textColor="@color/fg"
                android:textSize="52sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/loginStroke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="."
                android:textColor="@color/primary"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SIGN IN"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/bg_login"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="you@alex.dev"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"
                android:autofillHints="emailAddress"
                android:textColor="@color/fg"
                android:textColorHint="@color/dim"
                android:background="@drawable/input_field"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PASSWORD"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="********"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:autofillHints="password"
                android:textColor="@color/fg"
                android:textColorHint="@color/dim"
                android:background="@drawable/input_field"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="52dp"
                android:text="SIGN IN"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/btn_login"
                android:padding="14dp" />

            <TextView
                android:id="@+id/loginErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SIGN IN AS ADMIN"
            android:textColor="@color/dim"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />
    </LinearLayout>
</ScrollView>
